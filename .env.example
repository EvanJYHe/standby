NODE_ENV=development
PORT=3100
PUBLIC_BASE_URL=http://127.0.0.1:3100
SHOP_TIMEZONE=America/Toronto
BUSINESS_NAME=Standby
BUSINESS_LOCATION="Toronto, Ontario"
DEMO_MODE=true
OUTREACH_WORKER_ENABLED=false

# The seeded in-memory store powers the complete local product demo.
DATA_STORE=memory
MONGODB_DB=standby
MONGODB_URI=

# Everything below is optional. The UI and demo API work without it.
# Outbound work is disabled by default, even when credentials are present.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# Public Web OAuth client ID. Enable the Google Calendar API and add this
# app's exact local and production origins in Google Cloud before using it.
GOOGLE_OAUTH_CLIENT_ID=

VOICE_PROVIDER=disabled
VOICE_OUTBOUND_ENABLED=false
# Use an independent random value of at least 32 characters when voice is enabled.
VOICE_ACTOR_TOKEN_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_REQUEST_TIMEOUT_MS=20000

# One-off operator scripts remain inert unless these flags are explicitly changed.
APPLY_ELEVENLABS_CONFIG=false
EXECUTE_VOICE_CALL=false
DESTINATION_PHONE=
DEMO_CUSTOMER_ID=
DEMO_CUSTOMER_NAME=
