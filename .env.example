NODE_ENV=development
PORT=3100
PUBLIC_BASE_URL=http://127.0.0.1:3100
SHOP_TIMEZONE=America/Toronto
DEMO_MODE=true

# The seeded in-memory store powers the complete local product demo.
DATA_STORE=memory
MONGODB_DB=standby
MONGODB_URI=

# Everything below is optional. The UI and demo API work without it.
# Add provider credentials only when exercising the original voice/chat adapters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
SARAH_PHONE=
