{
  "name": "standby-scheduling-operator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "DATA_STORE=memory TELEGRAM_BOT_TOKEN= BACKBOARD_API_KEY= ELEVENLABS_API_KEY= node --env-file-if-exists=.env --import tsx --watch server.ts",
    "dev:api:integrations": "node --env-file-if-exists=.env --import tsx --watch server.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "dev:tunnel": "node --env-file=.env scripts/start-local-tunnel.mjs",
    "local": "npm run build && NODE_ENV=production PORT=3100 PUBLIC_BASE_URL=http://127.0.0.1:3100 npm start",
    "build": "vite build && tsup server.ts --format esm --out-dir dist/server --sourcemap --clean",
    "start": "node --env-file-if-exists=.env dist/server/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:run && npm run build",
    "setup:backboard": "node --env-file=.env scripts/configure-backboard.mjs",
    "setup:elevenlabs": "node --env-file=.env scripts/configure-elevenlabs.mjs",
    "setup:telegram": "node --env-file=.env scripts/register-telegram-webhook.mjs",
    "demo:call": "node --env-file=.env scripts/call-elevenlabs-demo.mjs",
    "demo:links": "node --env-file=.env scripts/telegram-demo-links.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.58.0",
    "@fastify/cors": "latest",
    "@fastify/static": "^10.1.2",
    "@vercel/analytics": "^2.0.1",
    "fastify": "^5.11.0",
    "fastify-raw-body": "^5.0.0",
    "lucide-react": "^1.28.0",
    "luxon": "latest",
    "mongodb": "latest",
    "pino": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.7.0",
    "undici": "^7.28.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/luxon": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "jsdom": "latest",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
